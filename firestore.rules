rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ผู้เข้าร่วมกิจกรรม
    match /responses/{responseId} {
      // ผู้เข้าร่วมสร้างผลของตัวเองได้ แต่แก้/ลบไม่ได้
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.consent == true
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.selectedWords is list
        && request.resource.data.selectedWords.size() == 5;

      // เฉพาะแอดมินอ่าน / จัดการข้อมูล
      allow read, update, delete: if isAdmin();
    }

    // เอกสารกำหนดสิทธิ์ผู้ดูแล
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if false; // ให้สร้าง/แก้ผ่าน Firebase Console เท่านั้น
    }
  }
}
